generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SignalSentiment {
  positive
  negative
  neutral
  mixed
}

enum RiskLevel {
  low
  medium
  high
}

enum FeedbackDirection {
  UP
  DOWN
  NEUTRAL
}

enum FeedbackType {
  LIKE
  DISLIKE
}

enum IngestionStatus {
  SUCCESS
  PARTIAL
  FAILED
  RUNNING
}

enum JobRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum FiscalQuarter {
  Q1
  Q2
  Q3
  Q4
}

enum GuidanceTone {
  POSITIVE
  NEUTRAL
  NEGATIVE
  UNKNOWN
}

enum EarningsSource {
  NSE
  BSE
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  telegramChatId  String?
  telegramEnabled Boolean     @default(false)
  createdAt       DateTime    @default(now())
  watchlists      Watchlist[]

  @@index([createdAt])
}

model Watchlist {
  id            String          @id @default(cuid())
  userId        String
  name          String
  tickers       WatchlistTicker[]
  createdAt     DateTime        @default(now())
  riskTolerance String          @default("medium")
  sectors       String[]
  themes        String[]
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model WatchlistTicker {
  id          String    @id @default(cuid())
  watchlistId String
  ticker      String
  createdAt   DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@index([watchlistId])
  @@index([ticker])
  @@unique([watchlistId, ticker])
}

model RawDocument {
  id                  String               @id
  source              String
  url                 String
  title               String
  content             String               @db.Text
  rawData             Json
  rawPayloadFormat    String
  urlHash             String               @unique
  publishedAt         DateTime
  fetchedAt           DateTime
  createdAt           DateTime             @default(now())
  normalizedDocuments NormalizedDocument[]

  @@index([source])
  @@index([publishedAt])
  @@index([fetchedAt])
}

model NormalizedDocument {
  id                 String           @id @default(cuid())
  rawDocumentId      String
  cleanedText        String           @db.Text
  language           String
  createdAt          DateTime         @default(now())
  rawDocument        RawDocument      @relation(fields: [rawDocumentId], references: [id], onDelete: Cascade)
  extractedEvents    ExtractedEvent[]

  @@index([rawDocumentId])
  @@index([createdAt])
}

model ExtractedEvent {
  id                    String           @id @default(cuid())
  normalizedDocumentId  String
  tickers               Json
  keywords              Json
  eventHints            Json
  createdAt             DateTime         @default(now())
  normalizedDocument    NormalizedDocument @relation(fields: [normalizedDocumentId], references: [id], onDelete: Cascade)
  enrichedEvents        EnrichedEvent[]

  @@index([normalizedDocumentId])
  @@index([createdAt])
}

model EnrichedEvent {
  id                 String           @id @default(cuid())
  extractedEventId   String
  eventType          String
  sentiment          SignalSentiment
  confidence         Float
  eventWeight        Float
  sourceCredibility  Float
  createdAt          DateTime         @default(now())
  extractedEvent     ExtractedEvent   @relation(fields: [extractedEventId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([createdAt])
}

model EventCluster {
  id          String      @id @default(cuid())
  ticker      String
  clusterHash String      @unique
  sourceCount Int
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime    @default(now())

  @@index([ticker])
  @@index([startTime])
  @@index([endTime])
}

model EngineSignal {
  id              String               @id
  ticker          String
  score           Float
  confidence      Float
  sentiment       SignalSentiment
  riskLevel       RiskLevel
  createdAt       DateTime             @default(now())
  explanation     SignalExplanation?
  clusterHash     String?

  @@index([ticker])
  @@index([score])
  @@index([createdAt])
}

model SignalExplanation {
  id        String       @id @default(cuid())
  signalId  String       @unique
  reasons   Json
  summary   String       @db.Text
  createdAt DateTime     @default(now())
  signal    EngineSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model FeedbackOutcome {
  id            String            @id @default(cuid())
  signalId      String
  outcome       FeedbackDirection
  priceChange   Float
  evaluatedAt   DateTime
  horizon       String?
  volumeChange  Float?
  userAction    String?

  @@index([signalId])
  @@index([evaluatedAt])
}

model SignalFeedback {
  id           String       @id @default(cuid())
  signalId     String
  userId       String?
  feedbackType FeedbackType
  createdAt    DateTime     @default(now())

  @@index([signalId])
  @@index([userId])
  @@map("signal_feedback")
}

model IngestionRun {
  id                String          @id @default(cuid())
  source            String
  status            IngestionStatus
  documentsFetched  Int
  errors            Json?
  startedAt         DateTime
  completedAt       DateTime?

  @@index([source])
  @@index([startedAt])
  @@index([completedAt])
}

model SourceHealth {
  id           String   @id @default(cuid())
  source       String   @unique
  lastRun      DateTime?
  successRate  Float
  failureCount Int

  @@index([source])
}

model MarketContextSnapshot {
  id              String   @id @default(cuid())
  niftyTrend      String
  bankNiftyTrend  String
  giftNiftyChange Float
  indiaVix        Float
  fiiFlowCr       Float
  diiFlowCr       Float
  globalCues      String
  sectorStrength  Json
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model PriceValidationSnapshot {
  id               String   @id @default(cuid())
  ticker           String
  breakout         Boolean
  breakdown        Boolean
  gapDirection     String
  volumeSpikeRatio Float
  relativeStrength Float
  deliverySpike    Boolean
  note             String   @db.Text
  createdAt        DateTime @default(now())

  @@index([ticker])
  @@index([createdAt])
}

model PriceData {
  id        String   @id @default(cuid())
  ticker    String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  createdAt DateTime @default(now())

  @@index([ticker])
  @@index([timestamp])
  @@unique([ticker, timestamp])
  @@map("price_data")
}

model JobRun {
  id          String       @id @default(cuid())
  jobName     String
  status      JobRunStatus
  startedAt   DateTime
  completedAt DateTime?
  error       String?
  metadata    Json?

  @@index([jobName])
  @@index([status])
  @@index([startedAt])
}

model EarningsEvent {
  id                     String         @id @default(uuid())
  ticker                 String
  companyName            String
  earningsDate           DateTime
  fiscalQuarter          FiscalQuarter
  fiscalYear             Int
  estimatedEPS           Float?
  actualEPS              Float?
  epsSurprisePercent     Float?
  estimatedRevenue       Float?
  actualRevenue          Float?
  revenueSurprisePercent Float?
  hasGuidance            Boolean        @default(false)
  guidanceTone           GuidanceTone   @default(UNKNOWN)
  source                 EarningsSource
  sourceUrl              String
  operatingProfit        Float?
  operatingMargin        Float?
  netProfit              Float?
  createdAt              DateTime       @default(now())

  @@index([ticker])
  @@index([earningsDate])
  @@index([fiscalQuarter])
  @@unique([ticker, sourceUrl])
}

model PriceBar {
  id        String   @id @default(cuid())
  ticker    String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  interval  String
  source    String
  createdAt DateTime @default(now())

  @@index([ticker])
  @@index([timestamp])
  @@index([ticker, timestamp])
  @@map("price_bars")
}

model SectorBar {
  id               String   @id @default(cuid())
  sector           String
  timestamp        DateTime
  close            Float
  changePercent    Float
  relativeStrength Float
  momentumScore    Float
  source           String
  createdAt        DateTime @default(now())

  @@index([sector])
  @@index([timestamp])
  @@index([sector, timestamp])
  @@map("sector_bars")
}

model InstitutionalFlow {
  id            String   @id @default(cuid())
  date          DateTime
  investorType  String   // "FII" or "DII"
  marketSegment String   // "EQUITY", "DEBT", "FNO"
  buyValue      Float
  sellValue     Float
  netValue      Float
  source        String
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([investorType])
  @@index([marketSegment])
  @@map("institutional_flows")
}

model DealEvent {
  id          String   @id @default(cuid())
  ticker      String
  companyName String
  dealType    String   // "BLOCK" or "BULK"
  buyerName   String?
  sellerName  String?
  quantity    Float
  price       Float
  dealValue   Float
  dealDate    DateTime
  source      String
  createdAt   DateTime @default(now())

  @@index([ticker])
  @@index([dealDate])
  @@index([dealType])
  @@map("deal_events")
}
